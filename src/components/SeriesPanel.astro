---
/**
 * The side rail listing every instalment of a series, with the current one marked.
 *
 * Built on the same editorial language as the rest of the site: a monospace
 * column label, hairline dividers, no gradient and no shadow. It used to carry a
 * full-height `from-orange-300 via-pink-300 to-purple-300` wash and a
 * `shadow-[5px_0px_10px_...]`, neither of which exists anywhere else here —
 * DESIGN.md §5.2 expresses elevation with `bg-special-*`, and §6.1 replaced the
 * decorative blobs outright.
 */
import { Icon } from "astro-icon/components";
import { type CollectionEntry, getCollection } from "astro:content";
import { getAllPosts } from "@/data/post";

interface Props {
	seriesId: string;
}

const { seriesId } = Astro.props;
const currentPath = Astro.url.pathname;

// Was `getCollection("post")` with no filter, so the panel happily listed drafts
// alongside published entries — and would have listed scheduled posts before
// their date, advertising a link that 404s.
const posts = await getAllPosts();
const series = await getCollection("series");

const postsSeries = series.find((s) => s.id === seriesId);
if (!postsSeries) {
	throw new Error(`Post(s) with Series ID '${seriesId}' not found.`);
}

let seriesPosts: CollectionEntry<"post">[] = [];
if (seriesId) {
	seriesPosts = posts
		.filter((p) => p.data.seriesId === seriesId)
		.sort((a, b) => (a.data.orderInSeries || 0) - (b.data.orderInSeries || 0));
}
---

<aside
	id="series-panel"
	class="fixed z-40 hidden min-h-screen bg-bgColor transition-all duration-300 ease-in-out lg:relative lg:block"
>
	<div
		class="flex h-full w-screen flex-col border-r border-color-250 bg-special-light px-8 pt-4 md:w-72 md:min-w-72 md:max-w-72 md:pt-8"
	>
		<p class="font-mono text-[0.6875rem] uppercase tracking-[0.22em] text-color-550">
			In this series
		</p>

		<button
			id="close-panel"
			class="absolute right-4 top-4 flex size-8 items-center justify-center rounded-lg bg-accent-base/5 text-accent-base hover:bg-accent-base/10 md:right-8 md:top-8"
			aria-label="Close series panel"
		>
			<Icon aria-hidden="true" class="size-6" focusable="false" name="hugeicons:cancel-01" />
		</button>

		<div class="sticky top-8 mt-6">
			<a
				href={`/series/${postsSeries.id}/`}
				aria-label={`About the ${postsSeries.data.title} series`}
				class="flex items-center gap-x-2 rounded-lg bg-accent-base px-3 py-2 font-medium text-bgColor transition-[filter] duration-200 hover:brightness-110"
			>
				<Icon aria-hidden="true" class="size-5 shrink-0" focusable="false" name="solar:notes-bold" />
				<span class="text-sm leading-tight">{postsSeries.data.title}</span>
			</a>

			{
				seriesPosts.length > 0 && (
					<ol role="list" class="mt-4 divide-y divide-color-250 text-sm">
						{seriesPosts.map((p, i) => {
							const isActive = currentPath === `/posts/${p.id}/`;
							return (
								<li class="py-2">
									<a
										href={`/posts/${p.id}/`}
										aria-current={isActive ? "page" : undefined}
										class:list={[
											"flex gap-x-3 rounded-lg px-2 py-1 transition-colors duration-200",
											isActive
												? "pointer-events-none bg-color-100 text-accent-two"
												: "text-color-600 hover:text-accent-two",
										]}
									>
										<span class="font-mono text-xs tabular-nums text-color-550">
											{String(p.data.orderInSeries ?? i + 1).padStart(2, "0")}
										</span>
										<span class="leading-snug">{p.data.title}</span>
									</a>
								</li>
							);
						})}
					</ol>
				)
			}
		</div>
	</div>
</aside>
