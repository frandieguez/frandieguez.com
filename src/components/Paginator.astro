---
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav
			aria-label="Pagination"
			class="mt-12 flex items-center gap-x-4 border-t border-color-250 pt-6 font-mono text-xs uppercase tracking-[0.18em]"
		>
			{prevUrl && (
				<a
					class="citrus-link me-auto py-2 text-color-550 hover:text-accent-two"
					data-astro-prefetch
					href={prevUrl.url}
				>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "Previous"}
				</a>
			)}
			{nextUrl && (
				<a
					class="citrus-link ms-auto py-2 text-color-550 hover:text-accent-two"
					data-astro-prefetch
					href={nextUrl.url}
				>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "Next"}
				</a>
			)}
		</nav>
	)
}
