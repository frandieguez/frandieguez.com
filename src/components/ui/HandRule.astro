---
/**
 * A hand-drawn horizontal rule. Does the job the parallax waves used to do —
 * separate one band from the next — with about 1/50th of the DOM.
 *
 * `vector-effect="non-scaling-stroke"` keeps the stroke hairline-crisp even
 * though preserveAspectRatio="none" stretches the viewBox horizontally.
 * The path id is prefixed so it can't collide with other inline SVGs.
 */
interface Props {
	class?: string;
	/** Reveal stagger, in ms. */
	delay?: number;
}

const { class: className, delay } = Astro.props;
---

<svg
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 1200 12"
	preserveAspectRatio="none"
	class:list={["hand-rule h-3 w-full text-accent-two/35", className]}
	style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
	<path
		d="M0 7 C 140 2, 270 11, 420 6 S 690 2, 900 8 S 1100 3, 1200 6"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		vector-effect="non-scaling-stroke"></path>
</svg>
