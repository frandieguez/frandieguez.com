---
/**
 * The portrait, with its offset registration outline.
 *
 * Replaces the avatar + animate-amoeba blob markup that was duplicated verbatim
 * between index.astro and about.astro. The organic silhouette survives as a
 * static `rounded-pebble` radius; the outline offset by 8px is a printer's
 * mis-registration mark, and it gives the one considered hover for free.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"figure"> {
	src: ImageMetadata;
	alt: string;
	/** true on the homepage, where the portrait is the LCP candidate. */
	eager?: boolean;
}

const {
	src,
	alt,
	eager = false,
	class: className,
	...attrs
} = Astro.props;
---

<figure class:list={["group/pic relative", className]} {...attrs}>
	<span
		aria-hidden="true"
		class="absolute inset-0 translate-x-2 translate-y-2 rounded-pebble border border-accent-two/45 transition-transform duration-200 group-hover/pic:translate-x-1 group-hover/pic:translate-y-1"
	></span>
	<Image
		src={src}
		alt={alt}
		widths={[144, 256, 320, 512]}
		sizes="(min-width: 768px) 15rem, 9rem"
		loading={eager ? "eager" : "lazy"}
		decoding={eager ? "sync" : "async"}
		class="relative aspect-square w-full rounded-pebble border border-color-200 object-cover"
	/>
</figure>
