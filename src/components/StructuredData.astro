---
/**
 * Renders a JSON-LD @graph as a single script element per page rather than
 * several, so the @id cross-references between Person, WebSite and BlogPosting
 * resolve inside one document.
 *
 * Do not write a literal script tag in this comment. Vite's dependency scanner
 * reads it as a real opening tag and treats everything after it as JavaScript,
 * which fails the dev server with `Expected ";" but found ...`. The production
 * build is unaffected, so it looks like it works right up until someone runs
 * `astro dev`.
 */
interface Props {
	graph: Record<string, unknown>[];
}

const { graph } = Astro.props;

// Escaping "<" is what stops a post title or description containing the literal
// text "</script>" from closing this element early. JSON.stringify alone does
// not do it, because "<" is a legal character in a JSON string.
const json = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": graph,
}).replace(/</g, "\\u003c");
---

<script is:inline type="application/ld+json" set:html={json} />
