---
/**
 * The header of a post page: monospace metadata line, display-scale title,
 * standfirst, optional cover image and series badge.
 *
 * The title size lives on a child <span> — global.css forces
 * `h1 { text-2xl !important }`. See DESIGN.md §3.4.
 */
import Badge from "@/components/Badge.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import HandRule from "@/components/ui/HandRule.astro";
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	content: CollectionEntry<"post">;
}

const { content } = Astro.props;

const dateTimeOptions: Intl.DateTimeFormatOptions = { month: "long" };

const postSeries = content.data.seriesId
	? await getCollection("series")
			.then((series) => series.find((s) => s.id === content.data.seriesId))
			.catch((err) => {
				console.error("Failed to find series:", err);
				return null;
			})
	: null;

// @ts-ignore:next-line — readingTime is injected by remark-reading-time and isn't
// part of the collection schema.
const readingTime = content.rendered?.metadata?.frontmatter?.readingTime as
	| string
	| undefined;
---

<header class="pb-10 md:pb-14">
	<div data-reveal class="flex items-center gap-5">
		<p
			class="flex flex-wrap items-center gap-x-2 font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-color-550 md:shrink-0 md:text-xs"
		>
			<FormattedDate
				date={content.data.publishDate}
				dateTimeOptions={dateTimeOptions}
			/>
			<span aria-hidden="true" class="text-color-450">·</span>
			<span>{readingTime ?? "Less than one minute read"}</span>
			{
				content.data.updatedDate && (
					<>
						<span aria-hidden="true" class="text-color-450">
							·
						</span>
						<span class="text-accent-two">
							Updated{" "}
							<FormattedDate
								date={content.data.updatedDate}
								dateTimeOptions={dateTimeOptions}
							/>
						</span>
					</>
				)
			}
			{
				content.data.draft && (
					<>
						<span aria-hidden="true" class="text-color-450">
							·
						</span>
						<span class="text-red-500">Draft</span>
					</>
				)
			}
		</p>
		<HandRule class="hidden flex-1 md:block" />
	</div>

	<div class="mt-5 flex items-start gap-3 md:mt-7">
		{
			postSeries && (
				<button
					aria-controls="series-panel"
					aria-label="Toggle Series Panel"
					class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-base/10 text-accent-base hover:brightness-110 md:mt-2 md:flex"
					id="toggle-panel"
				>
					<Icon
						aria-hidden="true"
						class="h-5 w-5 shrink-0"
						focusable="false"
						name="solar:notes-bold"
					/>
				</button>
			)
		}
		<h1 class="display-heading" data-pagefind-body title={content.data.title}>
			<span
				data-reveal="rise"
				style="--reveal-delay:60ms"
				class="block font-heading text-[2rem] font-bold leading-[1.04] tracking-[-0.02em] text-accent-base md:text-[3.25rem]"
			>
				{content.data.title}
			</span>
		</h1>
	</div>

	<p
		data-reveal="rise"
		style="--reveal-delay:120ms"
		class="mt-5 max-w-[62ch] text-lg leading-relaxed text-color-600"
		data-pagefind-body
	>
		{content.data.description}
	</p>

	{
		postSeries && (
			<a
				aria-label={`About ${postSeries.data.title} series`}
				class="mt-5 inline-flex items-center gap-2"
				data-reveal
				style="--reveal-delay:150ms"
				href={`/series/${postSeries.id}`}
			>
				<span class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-color-550">
					Series
				</span>
				<Badge
					variant="accent-base"
					showHash={false}
					title={postSeries.data.title}
				/>
			</a>
		)
	}

	{
		content.data.coverImage && (
			<div data-reveal style="--reveal-delay:180ms" class="mt-8 md:mt-10">
				<Image
					alt={content.data.coverImage.alt}
					class="w-full rounded-lg border border-color-200 object-cover"
					fetchpriority="high"
					loading="eager"
					src={content.data.coverImage.src}
				/>
			</div>
		)
	}
</header>
