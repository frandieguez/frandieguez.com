---
/**
 * The tag row at the foot of a post.
 *
 * A monospace label instead of the old tag icon, to match the other section
 * marks on the site (CONTENTS, ELSEWHERE, TAGS), and hairline chips instead of
 * solid terracotta fills.
 */
import Badge from "@/components/Badge.astro";

interface Props {
	tags?: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-6">
	<p
		class="font-mono text-[0.6875rem] uppercase tracking-[0.22em] text-color-550 sm:shrink-0 sm:pt-2"
	>
		Tagged
	</p>

	{
		tags?.length ? (
			<ul role="list" class="flex flex-wrap items-center gap-2">
				{tags.map((tag) => (
					<li>
						<a
							aria-label={`View all posts with the tag: ${tag}`}
							data-astro-prefetch
							href={`/tags/${tag}/`}
						>
							<Badge variant="muted" title={tag} />
						</a>
					</li>
				))}
			</ul>
		) : (
			<span class="text-sm text-color-450">No tags</span>
		)
	}
</div>
