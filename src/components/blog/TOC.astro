---
/**
 * Table of contents.
 *
 * It used to be a bordered card with its own header bar and a close button that
 * had no way back — closing it hid the TOC for the rest of the visit. This is an
 * instrument instead: a measuring rail (see TOCList.astro), no box, no shadow.
 *
 * Two variants because mobile previously had no table of contents at all:
 * - "rail": the sticky desktop aside.
 * - "disclosure": a native <details> above the article on mobile. Zero JS.
 */
import TOCList from "@/components/blog/TOCList.astro";
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
	variant?: "rail" | "disclosure";
}

const { headings, variant = "rail" } = Astro.props;

// h2 and h3 only. Deeper levels make the rail noisy, and h1 is the post title.
const items = headings.filter(({ depth }) => depth >= 2 && depth <= 3);

const eyebrow =
	"font-mono text-[0.6875rem] uppercase tracking-[0.22em] text-color-550";
---

{
	items.length > 0 &&
		(variant === "disclosure" ? (
			<nav aria-label="Table of contents">
				<details class="group border-y border-color-250">
					<summary
						class:list={[
							"flex cursor-pointer list-none items-center justify-between gap-4 py-4 marker:content-none",
							eyebrow,
						]}
					>
						<span>
							Contents <span class="text-color-450">· {items.length}</span>
						</span>
						<span
							aria-hidden="true"
							class="text-base leading-none text-accent-two transition-transform duration-200 group-open:rotate-45"
						>
							+
						</span>
					</summary>
					<TOCList items={items} class="pb-4" />
				</details>
			</nav>
		) : (
			<nav aria-label="Table of contents">
				<p class={eyebrow}>
					Contents <span class="text-color-450">· {items.length}</span>
				</p>
				<TOCList
					items={items}
					class="mt-4 max-h-[calc(100vh-11rem)] overflow-y-auto"
				/>
			</nav>
		))
}
