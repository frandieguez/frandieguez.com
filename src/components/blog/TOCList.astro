---
/**
 * The rail itself: a hairline vertical line, a terracotta fill that tracks
 * reading progress, and one tick per heading whose length encodes depth — h2
 * ticks are longer and start at the rail, h3 ticks are shorter and inset, so the
 * list reads like a ruler rather than an indented outline.
 *
 * State styling (`.toc-link`) lives in global.css: it's driven by `aria-current`,
 * which src/scripts/toc.ts sets while scrolling.
 */
import type { MarkdownHeading } from "astro";

interface Props {
	items: MarkdownHeading[];
	class?: string;
}

const { items, class: className } = Astro.props;
---

<ol role="list" class:list={["relative", className]}>
	<span
		aria-hidden="true"
		class="absolute bottom-0 left-0 top-0 w-px bg-color-250"></span>
	<span
		aria-hidden="true"
		data-toc-progress
		class="absolute bottom-0 left-0 top-0 w-px origin-top scale-y-0 bg-accent-two transition-transform duration-150"
	></span>

	{
		items.map((heading) => (
			<li>
				<a
					class:list={[
						"toc-link relative flex items-baseline py-2",
						heading.depth === 2 ? "pl-7" : "pl-9",
					]}
					data-toc-link
					href={`#${heading.slug}`}
				>
					<span
						aria-hidden="true"
						class:list={[
							"toc-tick absolute top-[0.85em] h-px",
							heading.depth === 2 ? "left-0 w-3.5" : "left-3 w-2.5",
						]}
					/>
					<span
						class:list={[
							"toc-label leading-snug",
							heading.depth === 2
								? "text-[0.8125rem]"
								: "text-xs text-color-500",
						]}
					>
						{heading.text}
					</span>
				</a>
			</li>
		))
	}
</ol>
