---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { siteConfig, menuLinks } from "@/site.config";
import { Icon } from "astro-icon/components";
import Logo from "../../assets/images/header.svg?react";
import GlassesMark from "../../assets/images/glasses.svg?react";

interface Props {
	/**
	 * Drop the wordmark and show only the glasses mark. Used on pages whose hero
	 * already states the name at display size, so the header doesn't say it twice.
	 */
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header
	id="main-header"
	class="fixed px-4 md:px-0 left-0 z-20 flex items-center md:relative top-0 h-16 w-full bg-bgColor md:bg-transparent overflow-hidden"
>
	<div class="w-full justify-between sm:flex-col">
		<div class="flex items-center gap-x-2">
			<a
				aria-label={siteConfig.title}
				aria-current={Astro.url.pathname === "/" ? "page" : false}
				class="group flex items-center hover:filter-none sm:relative"
				href="/"
			 >
				{/* text-accent-base, not text-black + a dark: variant: the logo also has
					to flip inside `.surface-dark`, which is dark in both themes and so
					never matches `dark:`. The token resolves to black in light mode
					anyway, so nothing changes outside the band. */}
				{/* `size-30` was not a real Tailwind class — there's no 30 in the spacing
					scale — so the logo rendered at its intrinsic size and ran into the
					search and theme buttons on narrow screens. */}
				<div
					title={siteConfig.title}
					class:list={[
						"inline-block text-accent-base [&>svg]:h-auto [&>svg]:w-full",
						compact ? "w-12 md:w-16" : "w-36 md:w-52",
					]}
				>
					{compact ? <GlassesMark /> : <Logo />}
				</div>
			</a>
			<nav
				aria-label="Main menu"
				class="text-sm mx-auto ml-4 hidden flex-col items-center justify-around gap-x-4 rounded-md bg-bgColor font-medium text-accent-two shadow backdrop-blur group-[.menu-open]:z-50 group-[.menu-open]:flex sm:static sm:z-auto sm:flex-row sm:items-center sm:rounded-none sm:bg-transparent sm:shadow-none sm:backdrop-blur-none md:flex"
				id="main-navigation-menu"
			>
				{
					menuLinks.map((link) => (
						<a
							aria-current={Astro.url.pathname === link.path ? "page" : false}
							class="uppercase flex gap-x-1 h-8 text-md items-center justify-center rounded-lg underline-offset-2 hover:underline"
							data-astro-prefetch
							href={link.path}
						>
							{link.title}
						</a>
					))
				}


			</nav>


			<div class="ml-auto w-fit">
				<div id="buttons-panel" class="top-4 md:top-8 -ml-[4.5rem] flex space-x-2">
					<Search />
					<ThemeToggle />
				</div>
			</div>

			<mobile-button
				aria-expanded="false"
				aria-haspopup="menu"
				aria-label="Open main menu"
				class="group relative h-8 w-8 rounded-lg bg-color-100 hover:bg-accent-base/10 text-accent-base md:invisible md:hidden"
				id="toggle-nav-menu-mobile"
				type="button"
			>
				<Icon
					id="open-nav-menu-icon"
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all"
					focusable="false"
					name="hugeicons:menu-01"
				/>
				<Icon
					id="close-nav-menu-icon"
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all"
					focusable="false"
					name="hugeicons:cancel-01"
				/>
			</mobile-button>
		</div>
	</div>
</header>

<div id="drawer" class="fixed inset-0 z-10 hidden" aria-hidden="true">
	<div
		id="drawer-body"
		class="absolute inset-0 -translate-y-full transform bg-bgColor transition-all duration-300 ease-in-out"
	>
		<nav
			aria-label="Mobile navigation menu"
			class="text-lg absolute inset-0 flex flex-col items-center justify-center gap-y-4 text-center font-medium text-accent-two"
			id="nav-menu-mobile"
		>
			{
				menuLinks.map((link) => (
					<a
						aria-current={Astro.url.pathname === link.path ? "page" : false}
						class="underline-offset-2 hover:underline"
						data-astro-prefetch
						href={link.path}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</div>

<script>
	// astro:page-load, not DOMContentLoaded: with <ClientRouter /> active the
	// latter never fires again after a client-side navigation, which left the
	// mobile menu button dead as soon as the visitor navigated once.
	document.addEventListener("astro:page-load", () => {
		const toggleNavMenuMobileButton = document.getElementById("toggle-nav-menu-mobile");
		const openMenuIcon = document.getElementById("open-nav-menu-icon");
		const closeMenuIcon = document.getElementById("close-nav-menu-icon");
		const drawer = document.getElementById("drawer");

		// Проверяем существование элементов
		if (!toggleNavMenuMobileButton || !openMenuIcon || !closeMenuIcon || !drawer) {
			console.error("One or more required elements are missing in the DOM.");
			return;
		}

		const drawerBody = document.getElementById("drawer-body");
		if (!drawerBody) {
			console.error("Drawer body element is missing in the DOM.");
			return;
		}

		toggleNavMenuMobileButton.addEventListener("click", () => {
			const isOpen = toggleNavMenuMobileButton.getAttribute("aria-expanded") === "true";

			if (isOpen) {
				// Close the menu.
				drawerBody.classList.add("opacity-0", "-translate-y-full");
				drawerBody.classList.remove("translate-y-0");

				// `aria-hidden` goes back up only after the exit transition, so the
				// drawer stays in the accessibility tree for as long as it is still
				// visible on screen.
				setTimeout(() => {
					drawer.classList.add("hidden");
					drawer.setAttribute("aria-hidden", "true");
				}, 300);

				// Swap the icons.
				openMenuIcon.classList.add("scale-100", "opacity-100");
				closeMenuIcon.classList.add("scale-0", "opacity-0");
				closeMenuIcon.classList.remove("scale-100", "opacity-100");
			} else {
				// Open the menu. The drawer carries a static `aria-hidden="true"` in
				// the markup so it is correctly absent before any JS runs; clearing it
				// here is what actually exposes the links. Without this the drawer
				// opened visually but stayed invisible to screen readers and to any
				// agent driving the page through the accessibility tree.
				drawer.classList.remove("hidden");
				drawer.setAttribute("aria-hidden", "false");
				drawerBody.classList.add("translate-y-0");
				drawerBody.classList.remove("opacity-0", "-translate-y-full");

				// Swap the icons.
				openMenuIcon.classList.add("scale-0", "opacity-0");
				closeMenuIcon.classList.add("scale-100", "opacity-100");
				openMenuIcon.classList.remove("scale-100", "opacity-100");
			}

			// Reflect the new state on the toggle.
			toggleNavMenuMobileButton.setAttribute("aria-expanded", (!isOpen).toString());
		});
	});
</script>
