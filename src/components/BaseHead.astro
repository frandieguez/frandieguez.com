---
import { WEBMENTION_PINGBACK, WEBMENTION_URL } from "astro:env/client";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";


type Props = SiteMeta;

const { articleDate, description, lang, noindex, ogImage, title } = Astro.props;

// og:locale wants an underscored form ("es_ES"), while <html lang> wants the
// hyphenated BCP 47 tag. Derive one from the other rather than storing both.
const ogLocale = lang ? lang.replace("-", "_") : siteConfig.ogLocale;

const titleSeparator = "•";

// Every page is "<Page> • Fran Dieguez", except the one whose title already opens
// with the name. The homepage leads with it on purpose: a personal site's only
// realistic query is the person, and "Full Stack Developer" is a phrase no
// personal site wins. Without this check that page would read "Fran Dieguez •
// Full Stack Developer & Web Tech Lead • Fran Dieguez".
const siteTitle = title.startsWith(siteConfig.title)
	? title
	: `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The fallback used to be /social-card.png, a file that does not exist, so every
// page without an explicit ogImage shipped a broken social card. /og-image/site.png
// is generated by src/pages/og-image/[...slug].[ext].ts alongside the post cards.
const socialImageURL = new URL(ogImage ? ogImage : "/og-image/site.png", Astro.url).href;
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>

<ClientRouter />

{/* Icons */}
<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
{
	import.meta.env.PROD && (
		<>
			{/* Favicon & Apple Icon */}
			<link rel="icon" href="/favicon-32x32.png" type="image/png" />
			<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
			{/* Manifest */}
			<link href="/manifest.webmanifest" rel="manifest" />
		</>
	)
}

{/* Canonical URL */}
<link href={canonicalURL} rel="canonical" />

{noindex && <meta content="noindex, follow" name="robots" />}

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Theme Colour */}
<meta content="" name="theme-color" />

{/* Open Graph / Facebook */}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
		</>
	)
}

{/* Twitter */}
<meta content="summary_large_image" property="twitter:card" />
<meta content={canonicalURL} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
<meta content={socialImageURL} property="twitter:image" />

{/* Fonts are self-hosted and bundled through src/styles/global.css — there is
	deliberately no third-party font origin to preconnect to. */}

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link href="/rss.xml" rel="alternate" title={siteConfig.title} type="application/rss+xml" />
{
	/* Notes have their own feed, advertised only where you are already reading
	   them. Sitewide it would offer every visitor a second subscription to a
	   noindexed side collection, which is not what a reader asking for "the
	   feed" of this site means. A title that says which feed it is, because a
	   reader showing two identical names is no help. */
	Astro.url.pathname.startsWith("/notes/") && (
		<link
			href="/notes/rss.xml"
			rel="alternate"
			title={`${siteConfig.title} — Notes`}
			type="application/rss+xml"
		/>
	)
}

{/* Webmentions */}
{
	WEBMENTION_URL && (
		<>
			<link href={WEBMENTION_URL} rel="webmention" />
			{WEBMENTION_PINGBACK && <link href={WEBMENTION_PINGBACK} rel="pingback" />}
		</>
	)
}

<meta content={Astro.generator} name="generator" />
