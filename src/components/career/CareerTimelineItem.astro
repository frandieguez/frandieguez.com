---
/**
 * One entry on the career rail.
 *
 * The rail and the node are drawn in CSS on the <li> itself, so there are no
 * extra elements in the accessibility tree. Role spans render only when they
 * exist — several are still unconfirmed in career.ts and publishing a wrong date
 * is worse than publishing none.
 */
import { formatRoleSpan, formatSpan, type CareerEntry } from "@/data/career";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li"> {
	entry: CareerEntry;
}

const { entry, class: className, ...attrs } = Astro.props;

const span = formatSpan(entry);
const [primary, ...previous] = entry.roles;

// Only worth dating the current role when there was a progression to distinguish
// it from — otherwise it just repeats the entry's own span.
const primarySpan =
	entry.roles.length > 1 && primary
		? formatRoleSpan(primary, entry.ongoing)
		: "";

const previousLabels = previous
	.map((role) => {
		const roleSpan = formatRoleSpan(role, entry.ongoing);
		return roleSpan ? `${role.title} ${roleSpan}` : role.title;
	})
	.join(" · ");

// Ongoing entries get a hollow node, finished ones a filled node.
const node = entry.ongoing
	? "border-accent-two bg-bgColor"
	: "border-accent-two/40 bg-accent-two/40";
---

<li
	class:list={["group relative pb-10 pl-7 md:pb-14 md:pl-12", className]}
	{...attrs}
>
	<span
		aria-hidden="true"
		class:list={[
			"absolute left-0 top-2 size-3.5 rounded-full border transition-transform duration-200 group-hover:scale-125",
			node,
		]}></span>

	<div class="grid gap-x-8 md:grid-cols-[8.5rem_1fr]">
		<p
			class="font-mono text-xs uppercase tabular-nums tracking-[0.16em] text-color-550 md:pt-[0.35rem]"
		>
			{span}
		</p>
		<div>
			<h3 class="display-heading">
				{
					entry.orgUrl ? (
						<a
							href={entry.orgUrl}
							rel="noopener noreferrer"
							target="_blank"
							class="citrus-link"
						>
							<span class="block font-heading text-2xl font-bold uppercase leading-[1.05] tracking-[-0.01em] text-accent-base transition-colors group-hover:text-accent-two md:text-[1.75rem]">
								{entry.org}
							</span>
						</a>
					) : (
						<span class="block font-heading text-2xl font-bold uppercase leading-[1.05] tracking-[-0.01em] text-accent-base md:text-[1.75rem]">
							{entry.org}
						</span>
					)
				}
			</h3>

			{
				primary && (
					<p class="mt-1 text-base font-medium text-accent-two md:text-lg">
						{primary.title}
						{primarySpan && <span class="text-color-550"> · {primarySpan}</span>}
					</p>
				)
			}

			{
				previousLabels && (
					<p class="mt-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-color-550">
						Previously {previousLabels}
					</p>
				)
			}

			<p class="mt-3 max-w-[48ch] text-base leading-relaxed text-color-600">
				{entry.summaryShort}
			</p>
		</div>
	</div>
</li>
