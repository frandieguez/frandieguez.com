---
/**
 * The long-form career entry for /about: rail, node, copy column and a photo
 * mosaic. Replaces Workline.astro, which hardcoded a second, contradictory copy
 * of the career data, used raw <img>, and carried an off-palette emerald glow
 * plus shadows that DESIGN.md §5.2 rules out.
 *
 * The gentle rotation on the figures is kept — it's the one playful gesture that
 * survived the redesign — but it's now a transform on a bordered, shadowless card.
 */
import {
	formatRoleSpan,
	formatSpan,
	type CareerEntry,
} from "@/data/career";
import { Image } from "astro:assets";

interface Props {
	entry: CareerEntry;
	index: number;
}

const { entry, index } = Astro.props;

const span = formatSpan(entry);
const roleLines = entry.roles.map((role) => {
	const roleSpan = formatRoleSpan(role, entry.ongoing);
	return roleSpan ? `${role.title} — ${roleSpan}` : role.title;
});

// Index-cycled tilt, straightened on hover.
const tilts = ["-rotate-[1.5deg]", "rotate-[1deg]", "rotate-[0.5deg]"];

---

<article class="relative pb-16 pl-8 md:pb-24 md:pl-0">
	<span
		aria-hidden="true"
		class:list={[
			"absolute left-0 top-2 size-3.5 rounded-full border md:left-[7px]",
			entry.ongoing
				? "border-accent-two bg-bgColor"
				: "border-accent-two/40 bg-accent-two/40",
		]}></span>

	<div class="grid grid-cols-1 gap-8 md:grid-cols-5 md:gap-12">
		<header data-reveal="side" class="md:col-span-2 md:pl-12">
			{
				entry.eyebrow && (
					<p class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-accent-two">
						{entry.eyebrow}
					</p>
				)
			}

			<h3 class="display-heading mt-2">
				<span
					class="block font-heading text-2xl font-bold uppercase leading-[1.05] tracking-[-0.01em] text-accent-base md:text-[1.75rem]"
				>
					{entry.org}
				</span>
			</h3>

			{
				span && (
					<p class="mt-1 font-mono text-xs uppercase tabular-nums tracking-[0.16em] text-color-550">
						{span}
					</p>
				)
			}

			<ul role="list" class="mt-3 space-y-0.5">
				{
					roleLines.map((line) => (
						<li class="text-base font-medium text-accent-two">{line}</li>
					))
				}
			</ul>

			<p class="mt-4 max-w-[46ch] text-base leading-relaxed text-color-600">
				{entry.summaryLong}
			</p>

			{
				entry.link && (
					<a
						href={entry.link.href}
						rel="noopener noreferrer"
						target="_blank"
						class="citrus-link group mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent-two"
					>
						{entry.link.label}
						<span
							aria-hidden="true"
							class="transition-transform group-hover:translate-x-1"
						>
							→
						</span>
					</a>
				)
			}
		</header>

		{
			entry.media && entry.media.length > 0 && (
				/* `content-start` keeps the rows at their natural height. This column
					sits beside the copy in a 5-column grid, so when an entry has a lot of
					text the media column is handed more height than its rows need — and
					auto rows absorb that extra space by default, stretching every tile.
					Pinning them to the top leaves the slack at the bottom of the column
					instead, where nobody sees it. */
				<div
					data-reveal
					style={`--reveal-delay:${90 + index * 30}ms`}
					class="grid grid-cols-2 content-start gap-3 md:col-span-3 sm:grid-cols-3"
				>
					{entry.media.map((media, i) => (
						<figure
							class:list={[
								// The aspect ratio belongs on the figure, not on the button
								// inside it. A grid item defaults to align-self: stretch, so
								// without a ratio here the figure grows to the row height while
								// the image keeps its own — leaving the border and background
								// standing as a tall empty box under the picture.
								"aspect-[4/3] overflow-hidden rounded-lg border border-color-200 bg-color-50 transition-transform duration-200 hover:rotate-0",
								tilts[i % tilts.length],
							]}
						>
							{/* A real <button>, not a click handler on the figure: it has to
								be reachable by keyboard and announce itself as an action.
								The alt text doubles as the accessible name, so a screen
								reader hears what it would be opening. */}
							<button
								aria-label={`View larger: ${media.alt}`}
								class="group/shot block h-full w-full cursor-zoom-in"
								data-lb
								data-lb-alt={media.alt}
								data-lb-group={entry.id}
								data-lb-ratio={media.src.width / media.src.height}
								type="button"
							>
								{/* The last width is the one the lightbox uses. It is capped at
									the file's own width because these screenshots range from
									800px wide to 3010px, so a fixed large value would upscale
									half of them. `sizes` still describes the thumbnail, so the
									browser only fetches a big rendition on a high-DPI screen —
									the lightbox reads the URL straight out of the srcset. */}
								<Image
									src={media.src}
									alt={media.alt}
									widths={[
										240,
										400,
										640,
										Math.min(1600, media.src.width),
									]}
									sizes="(min-width: 768px) 14rem, 45vw"
									loading="lazy"
									decoding="async"
									class="h-full w-full object-cover transition-transform duration-300 group-hover/shot:scale-[1.03]"
								/>
							</button>
						</figure>
					))}
				</div>
			)
		}
	</div>
</article>
