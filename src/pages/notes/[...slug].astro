---
import { getCollection, render } from "astro:content";

import FormattedDate from "@/components/FormattedDate.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import PageLayout from "@/layouts/Base.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

// If you're using an adaptor in SSR mode, getStaticPaths wont work -> https://docs.astro.build/en/guides/routing/#modifying-the-slug-example-for-ssr
export const getStaticPaths = (async () => {
	const allNotes = await getCollection("note");
	return allNotes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}) satisfies GetStaticPaths;

export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note } = Astro.props;
const { Content } = await render(note);

const meta = {
	description:
		note.data.description ||
		`Read about my note posted on: ${note.data.publishDate.toLocaleDateString()}`,
	lang: note.data.lang,
	// Notes are deliberately out of the index. Most of this collection is the
	// 2007-2008 link posts — a bare video URL, one image — which are real history
	// worth keeping reachable and bad pages to offer a search engine. `follow`,
	// not `none`: the links in them still deserve to be crawled.
	noindex: true,
	title: note.data.title,
};

const dateOptions = {
	year: "numeric",
	month: "long",
	day: "2-digit",
} as const;
---

<PageLayout meta={meta}>
	<article data-pagefind-body>
		<PageHeading eyebrow="Note" title={note.data.title}>
			<p
				data-reveal
				style="--reveal-delay:160ms"
				class="mt-6 font-mono text-xs uppercase tracking-[0.18em] text-color-550"
			>
				<FormattedDate date={note.data.publishDate} dateTimeOptions={dateOptions} />
			</p>
		</PageHeading>

		<div
			data-reveal
			class="prose prose-citrus max-w-none pb-20 md:pb-28 [&>p:last-of-type]:mb-0"
		>
			<Content />
		</div>
	</article>
</PageLayout>
