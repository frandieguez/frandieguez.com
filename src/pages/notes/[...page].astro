---
import { type CollectionEntry, getCollection } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import Note from "@/components/note/Note.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_NOTES_PER_PAGE = 6;
	const allNotes = await getCollection("note");
	const sorted = allNotes.sort(collectionDateSort);
	const oldest = sorted.at(-1)?.data.publishDate.getFullYear();
	const newest = sorted[0]?.data.publishDate.getFullYear();

	return paginate(sorted, {
		pageSize: MAX_NOTES_PER_PAGE,
		props: { total: sorted.length, oldest, newest },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
	total: number;
	oldest?: number;
	newest?: number;
}

const { page, total, oldest, newest } = Astro.props;

const range = oldest && newest && oldest !== newest ? `${oldest}–${newest}` : `${newest ?? ""}`;
const eyebrow = [`Notes — ${total}`, range].filter(Boolean).join(" · ");

const meta = {
	description: "Read my collection of notes",
	// Kept out of the index along with the notes themselves — a listing of
	// noindexed pages has nothing to offer a search result.
	noindex: true,
	title: "Notes",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Page",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Page →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section>
		<PageHeading
			eyebrow={eyebrow}
			title="Notes"
			standfirst="Short pieces that are not articles: links, one-line thoughts, and the tumblr-era posts this blog collected between 2007 and 2008."
		>
			<a
				class="citrus-link group mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-color-550 hover:text-accent-two"
				data-reveal
				style="--reveal-delay:160ms"
				href="/notes/rss.xml"
				target="_blank"
			>
				<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:rss" />
				Subscribe to notes
			</a>
		</PageHeading>

		{/* No wrapper element around <Note>: the article has to BE the grid item,
			otherwise the wrapper stretches to the row height and the card inside
			it keeps hugging its own content. */}
		<div class="grid grid-cols-1 gap-8 pb-20 md:grid-cols-2 md:pb-28">
			{
				page.data.map((note, i) => (
					<Note
						note={note}
						as="h2"
						isPreview
						data-reveal
						style={`--reveal-delay:${Math.min(i, 6) * 45}ms`}
					/>
				))
			}
		</div>

		<Pagination {...paginationProps} />
	</section>
</PageLayout>
