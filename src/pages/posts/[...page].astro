---
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Badge from "@/components/Badge.astro";
import HandRule from "@/components/ui/HandRule.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 15;
	const MAX_TAGS = 20;
	const allPosts = await getAllPosts();
	const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);
	const sorted = allPosts.sort(collectionDateSort);
	const oldest = sorted.at(-1)?.data.publishDate.getFullYear();
	const newest = sorted[0]?.data.publishDate.getFullYear();

	return paginate(sorted, {
		pageSize: MAX_POSTS_PER_PAGE,
		props: { uniqueTags, total: sorted.length, oldest, newest },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
	total: number;
	oldest?: number;
	newest?: number;
}

const { page, uniqueTags, total, oldest, newest } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: { text: "← Previous page", url: page.url.prev },
	}),
	...(page.url.next && {
		nextUrl: { text: "Next page →", url: page.url.next },
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const range = oldest && newest ? `${oldest}–${newest}` : "";
const eyebrow = [`Writing — ${total} posts`, range].filter(Boolean).join(" · ");
---

<PageLayout meta={meta}>
	<PageHeading
		eyebrow={eyebrow}
		title="Posts"
		standfirst="Linux and sysadmin notes from the late 2000s, Ruby, PHP and Git from the years after, and lately code agents, team leadership and web performance."
	>
		<a
			class="citrus-link group mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-color-550 hover:text-accent-two"
			data-reveal
			style="--reveal-delay:160ms"
			href="/rss.xml"
			target="_blank"
		>
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:rss" />
			Subscribe via RSS
		</a>
	</PageHeading>

	<div class="grid gap-x-12 gap-y-12 pb-20 md:pb-28 lg:grid-cols-[1fr_14rem]">
		<section aria-label="Blog post list">
			{
				descYearKeys.map((yearKey, groupIndex) => (
					<div class={groupIndex === 0 ? "" : "mt-14"}>
						<div class="flex items-center gap-5">
							<p
								data-reveal
								class="font-mono text-xs uppercase tabular-nums tracking-[0.22em] text-accent-two"
							>
								{yearKey}
							</p>
							<HandRule class="flex-1" />
						</div>

						<ul role="list" class="mt-2 divide-y divide-color-250">
							{groupedByYear[yearKey]?.map((p, i) => (
								<li
									data-reveal
									style={`--reveal-delay:${Math.min(i, 6) * 45}ms`}
									class="group -mx-2 rounded-lg px-2 py-5 transition-colors duration-200 hover:bg-color-50"
								>
									<PostPreview post={p} withDesc={true} forPage="posts" />
								</li>
							))}
						</ul>
					</div>
				))
			}

			<Pagination {...paginationProps} />
		</section>

		{
			!!uniqueTags.length && (
				<aside data-reveal style="--reveal-delay:90ms" class="lg:pt-1">
					<p class="font-mono text-xs uppercase tracking-[0.22em] text-color-550">
						Tags
					</p>
					<ul role="list" class="mt-5 flex flex-wrap gap-2">
						{uniqueTags.map((tag) => (
							<li>
								<a
									aria-label={`View all posts with the tag: ${tag}`}
									data-astro-prefetch
									href={`/tags/${tag}/`}
								>
									<Badge variant="muted" title={tag} />
								</a>
							</li>
						))}
					</ul>
					<a
						aria-label="View all blog categories"
						class="citrus-link group mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent-two"
						href="/tags/"
					>
						View all tags
						<span
							aria-hidden="true"
							class="transition-transform group-hover:translate-x-1"
						>
							→
						</span>
					</a>
				</aside>
			)
		}
	</div>
</PageLayout>
