---
import PageHeading from "@/components/ui/PageHeading.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Get in touch with Fran Dieguez. Fill out the contact form and I'll get back to you as soon as possible.",
	title: "Contact",
};

// Shared by the three fields so they can't drift apart.
const field =
	"w-full rounded-lg border border-color-250 bg-special-lighter px-4 py-2.5 text-base text-textColor transition-colors placeholder:text-color-450 hover:bg-special-lightest focus:border-accent-two focus:outline-none";

const label =
	"block font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-accent-two";
---

<PageLayout meta={meta}>
	<PageHeading
		eyebrow="Contact — usually replies within a day or two"
		title="Get in touch"
		standfirst="A question, some feedback, a project worth building, or just hello. Fill in the form and I'll get back to you."
	/>

	<section class="pb-20 md:pb-28">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
			<form
				data-reveal
				action="https://formspree.io/f/xrbpbpkq"
				name="contact"
				method="POST"
				data-netlify="true"
				netlify-honeypot="bot-field"
				class="flex flex-col gap-6 md:col-span-7"
			>
				<input type="hidden" name="bot-field" />

				<div class="flex flex-col gap-2">
					<label class={label} for="name">Name</label>
					<input
						class={field}
						id="name"
						name="name"
						placeholder="Your name"
						required
						type="text"
					/>
				</div>

				<div class="flex flex-col gap-2">
					<label class={label} for="email">Email</label>
					<input
						class={field}
						id="email"
						name="email"
						placeholder="you@email.com"
						required
						type="email"
					/>
				</div>

				<div class="flex flex-col gap-2">
					<label class={label} for="message">Message</label>
					<textarea
						class:list={[field, "resize-y"]}
						id="message"
						name="message"
						placeholder="Type your message here…"
						required
						rows={7}></textarea>
				</div>

				<button
					class="group inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-accent-two px-6 text-base font-semibold text-bgColor transition-all hover:brightness-110 sm:self-start"
					type="submit"
				>
					Send message
					<span
						aria-hidden="true"
						class="transition-transform group-hover:translate-x-1">→</span
					>
				</button>
			</form>

			<aside data-reveal style="--reveal-delay:90ms" class="md:col-span-5">
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-color-550">
					Elsewhere
				</p>
				<ul role="list" class="mt-5 divide-y divide-color-250">
					<li class="py-4">
						<a
							class="citrus-link group flex items-baseline justify-between gap-4"
							href="https://www.linkedin.com/in/frandieguez/"
							rel="me noopener noreferrer"
							target="_blank"
						>
							<span
								class="text-base font-medium text-accent-base transition-colors group-hover:text-accent-two"
								>LinkedIn</span
							>
							<span
								class="font-mono text-xs uppercase tracking-[0.14em] text-color-550"
								>in/frandieguez</span
							>
						</a>
					</li>
					<li class="py-4">
						<a
							class="citrus-link group flex items-baseline justify-between gap-4"
							href="https://github.com/frandieguez"
							rel="me noopener noreferrer"
							target="_blank"
						>
							<span
								class="text-base font-medium text-accent-base transition-colors group-hover:text-accent-two"
								>GitHub</span
							>
							<span
								class="font-mono text-xs uppercase tracking-[0.14em] text-color-550"
								>frandieguez</span
							>
						</a>
					</li>
					<li class="py-4">
						<a
							class="citrus-link group flex items-baseline justify-between gap-4"
							href="https://l10n.gnome.org/teams/gl"
							rel="noopener noreferrer"
							target="_blank"
						>
							<span
								class="text-base font-medium text-accent-base transition-colors group-hover:text-accent-two"
								>GNOME · Galician team</span
							>
							<span
								class="font-mono text-xs uppercase tracking-[0.14em] text-color-550"
								>l10n.gnome.org</span
							>
						</a>
					</li>
					<li class="py-4">
						<a
							class="citrus-link group flex items-baseline justify-between gap-4"
							href="/rss.xml"
						>
							<span
								class="text-base font-medium text-accent-base transition-colors group-hover:text-accent-two"
								>RSS</span
							>
							<span
								class="font-mono text-xs uppercase tracking-[0.14em] text-color-550"
								>/rss.xml</span
							>
						</a>
					</li>
				</ul>

				<p class="mt-8 max-w-[34ch] text-sm leading-relaxed text-color-600">
					Open to collaborating on things that are genuinely interesting.
				</p>
			</aside>
		</div>
	</section>
</PageLayout>
