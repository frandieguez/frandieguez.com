---
/**
 * Astro serves this for any unmatched route, and Cloudflare Pages picks it up
 * as the site's 404 document automatically.
 *
 * `noindex` because the literal path /404 is also directly addressable and
 * returns 200 — Astro treats it as an ordinary page as well as the error
 * document. Without this, anyone linking to /404 would get a "page not found"
 * screen indexed as real content.
 */
import ButtonLink from "@/components/ui/ButtonLink.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "That page doesn't exist — here's the way back.",
	noindex: true,
	title: "Page not found",
};
---

<PageLayout meta={meta}>
	<PageHeading
		eyebrow="404 — page not found"
		title="This one's missing"
		standfirst="The link may be old, or I may have moved something. The archive goes back to 2007, so there's a decent chance what you wanted is still here under a different URL."
	/>

	<section class="pb-20 md:pb-28">
		<div data-reveal class="flex flex-col gap-4 sm:flex-row sm:items-center">
			<ButtonLink href="/posts/">Browse all posts</ButtonLink>
			<ButtonLink href="/" variant="secondary">Back to the homepage</ButtonLink>
		</div>
	</section>
</PageLayout>
