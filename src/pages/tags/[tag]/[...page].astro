---
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import { getAllPosts, getUniqueTags } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { breadcrumbSchema, collectionPageSchema } from "@/data/schema";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(sortedPosts);

	return uniqueTags.flatMap((tag) => {
		const filterPosts = sortedPosts.filter((post) =>
			post.data.tags.includes(tag)
		);
		return paginate(filterPosts, { pageSize: 10, params: { tag } });
	});
};

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;
const { tag } = Astro.params;

const pageSuffix = page.currentPage > 1 ? ` (page ${page.currentPage})` : "";

/**
 * A tag page earns indexing by grouping enough posts to be worth landing on.
 *
 * Must match MIN_POSTS_PER_INDEXED_TAG in astro.config.ts, which applies the
 * same rule to the sitemap. Keeping the sitemap rule alone was half a fix: this
 * archive has 261 tags across 93 posts and 213 of them sit on exactly one post,
 * so 237 tag pages were out of the sitemap and still fully indexable, reachable
 * from the tag list under every post. Staying out of the sitemap is not a
 * request to leave a page out of the index; `noindex` is.
 *
 * `follow`, so the posts these pages link to keep being crawled, and no
 * navigation changes — a reader browsing by tag still gets the page.
 */
const MIN_POSTS_PER_INDEXED_TAG = 3;

const meta = {
	// Was the bare template "View all posts with the tag - {tag}" on all 304 tag
	// pages. Naming the count at least differentiates them from each other — and
	// naming the page differentiates /tags/sysadmin/2/ from /tags/sysadmin/,
	// which otherwise shipped the same sentence. The titles already carried the
	// page number; the descriptions did not, so six pairs were identical.
	description:
		page.currentPage > 1
			? `Page ${page.currentPage} of ${page.lastPage} — posts tagged ${tag} on Fran Dieguez's blog.`
			: `${page.total} post${page.total === 1 ? "" : "s"} tagged ${tag} on Fran Dieguez's blog.`,
	noindex: page.total < MIN_POSTS_PER_INDEXED_TAG,
	title: `Tag: ${tag}${pageSuffix}`,
};

const schema = [
	collectionPageSchema({
		path: page.currentPage > 1 ? `/tags/${tag}/${page.currentPage}/` : `/tags/${tag}/`,
		name: meta.title,
		description: meta.description,
	}),
	breadcrumbSchema([
		{ name: "Home", path: "/" },
		{ name: "Tags", path: "/tags/" },
		{ name: `#${tag}`, path: `/tags/${tag}/` },
	]),
];

const paginationProps = {
	...(page.url.prev && {
		prevUrl: { text: "← Newer posts", url: page.url.prev },
	}),
	...(page.url.next && {
		nextUrl: { text: "Older posts →", url: page.url.next },
	}),
};

const count = page.total;
---

<PageLayout meta={meta} schema={schema}>
	<PageHeading
		eyebrow={`Tag — ${count} post${count === 1 ? "" : "s"}`}
		title={`#${tag}`}
	>
		<a
			class="citrus-link group mt-6 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.18em] text-color-550 hover:text-accent-two"
			data-astro-prefetch
			data-reveal
			style="--reveal-delay:120ms"
			href="/tags/"
		>
			<span aria-hidden="true" class="transition-transform group-hover:-translate-x-1"
				>←</span
			>
			All tags
		</a>
	</PageHeading>

	<section aria-label="Blog post list" class="pb-20 md:pb-28">
		<ul role="list" class="divide-y divide-color-250 border-t border-color-250">
			{
				page.data.map((p, i) => (
					<li
						data-reveal
						style={`--reveal-delay:${Math.min(i, 8) * 45}ms`}
						class="group -mx-2 rounded-lg px-2 py-5 transition-colors duration-200 hover:bg-color-50"
					>
						<PostPreview post={p} withDesc={true} forPage="posts" />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
