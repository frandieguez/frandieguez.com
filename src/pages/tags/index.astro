---
import PageHeading from "@/components/ui/PageHeading.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
// Already sorted by count, descending.
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: "Tags",
};
---

<PageLayout meta={meta}>
	<PageHeading
		eyebrow={`Tags — ${allTags.length} topics across ${allPosts.length} posts`}
		title="Tags"
		standfirst="Sorted by how often they come up. The long tail is mostly the 2007–2013 sysadmin era, some of it in Spanish."
	/>

	<section aria-label="All tags" class="pb-20 md:pb-28">
		<ul
			role="list"
			class="grid grid-cols-1 border-t border-color-250 sm:grid-cols-2 lg:grid-cols-3"
		>
			{
				allTags.map(([tag, count], i) => (
					<li
						data-reveal
						style={`--reveal-delay:${Math.min(i, 12) * 25}ms`}
						class="border-b border-color-250"
					>
						<a
							aria-label={`View all posts with the tag: ${tag}`}
							class="citrus-link group flex items-baseline justify-between gap-4 px-2 py-3.5 transition-colors duration-200 hover:bg-color-50"
							data-astro-prefetch
							href={`/tags/${tag}/`}
						>
							<span class="text-base text-accent-base transition-colors group-hover:text-accent-two">
								<span aria-hidden="true" class="text-color-450">
									#
								</span>
								{tag}
							</span>
							<span class="shrink-0 font-mono text-xs tabular-nums text-color-550">
								{count}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
