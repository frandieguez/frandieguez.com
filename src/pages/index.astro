---
import CareerTimeline from "@/components/career/CareerTimeline.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import SectionHeader from "@/components/home/SectionHeader.astro";
import WritingSection from "@/components/home/WritingSection.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { careerBefore, careerNow } from "@/data/career";
import PageLayout from "@/layouts/Base.astro";

const trajectoryId = "trajectory-heading";

// Experiment: "split" = portrait right, type left. "bleed" = portrait as a
// left-anchored backdrop, type right. Swap to compare.
const heroVariant = "bleed" as "split" | "bleed";
---

<PageLayout heroBand meta={{ title: "Home" }}>
	<HomeHero slot="hero" variant={heroVariant} />

	<WritingSection />

	<section aria-labelledby={trajectoryId} class="pb-20 md:pb-32">
		<SectionHeader
			id={trajectoryId}
			ordinal="03"
			title="Trajectory"
			standfirst="Four places, two of them still going, one constant: making the web faster."
		/>

		<CareerTimeline label="Now" entries={careerNow} class="mt-12" />
		<CareerTimeline label="Before" entries={careerBefore} class="mt-4" />

		<div data-reveal class="mt-4">
			<ButtonLink href="/about/" variant="secondary">
				The long version, with pictures
				<span
					aria-hidden="true"
					class="transition-transform group-hover:translate-x-1">→</span
				>
			</ButtonLink>
		</div>
	</section>
</PageLayout>
