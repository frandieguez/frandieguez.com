---
import CareerTimeline from "@/components/career/CareerTimeline.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import SectionHeader from "@/components/home/SectionHeader.astro";
import WritingSection from "@/components/home/WritingSection.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { careerBefore, careerNow } from "@/data/career";
import PageLayout from "@/layouts/Base.astro";

const trajectoryId = "trajectory-heading";
---

<PageLayout
	heroBand
	meta={{
		// Was "Home", which spent the most valuable token position on the most
		// important title tag of the site saying nothing. BaseHead appends
		// " • Fran Dieguez", so this reads as a full positioning line in a SERP.
		title: "Full Stack Developer & Web Tech Lead",
	}}
>
	<HomeHero slot="hero" />

	<WritingSection />

	<section aria-labelledby={trajectoryId} class="pb-20 md:pb-32">
		<SectionHeader
			id={trajectoryId}
			ordinal="03"
			title="Trajectory"
			standfirst="Four places, all of them still going, one constant: making useful products."
		/>

		<CareerTimeline label="Now" entries={careerNow} class="mt-12" />
		<CareerTimeline label="Before" entries={careerBefore} class="mt-4" />

		<div data-reveal class="mt-4">
			<ButtonLink href="/about/" variant="secondary">
				The long version, with pictures
				<span
					aria-hidden="true"
					class="transition-transform group-hover:translate-x-1">→</span
				>
			</ButtonLink>
		</div>
	</section>
</PageLayout>
