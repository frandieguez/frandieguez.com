---
import CareerDetail from "@/components/career/CareerDetail.astro";
import HandRule from "@/components/ui/HandRule.astro";
import Avatar from "@/components/ui/Avatar.astro";
import { career } from "@/data/career";
import Lightbox from "@/components/ui/Lightbox.astro";
import PageLayout from "@/layouts/Base.astro";
import { breadcrumbSchema, profilePageSchema } from "@/data/schema";
import profilePic from "@/assets/images/profile-pic.jpg";

const meta = {
	description:
		"Fran Dieguez — nineteen years building for the web, from open-source consulting to Head of R&D and Web Tech Lead at Situm.",
	title: "About",
};

const schema = [
	profilePageSchema(),
	breadcrumbSchema([
		{ name: "Home", path: "/" },
		{ name: "About", path: "/about/" },
	]),
];
---

<PageLayout meta={meta} schema={schema}>
	<section class="relative pb-16 pt-4 md:pb-24 md:pt-8">
		<div data-reveal class="flex items-center gap-5">
			<p
				class="font-mono text-[0.6875rem] uppercase leading-relaxed tracking-[0.2em] text-color-550 md:shrink-0 md:text-xs"
			>
				About — Galicia, Spain · Full stack since 2006
			</p>
			<HandRule class="hidden flex-1 md:block" />
		</div>

		{/* An editorial spread rather than a heading with a sticker beside it: the
			portrait gets a real column instead of floating at 169px in a void. */}
		<div class="mt-7 grid grid-cols-1 gap-10 md:mt-12 md:grid-cols-12 md:gap-12">
			<div class="md:col-span-7">
				<h1 class="display-heading">
					<span
						data-reveal
						style="--reveal-delay:40ms"
						class="block font-heading text-[2.75rem] font-bold uppercase leading-[0.92] tracking-[-0.02em] text-accent-base md:text-[5rem]"
					>
						Hey, I'm Fran
					</span>
				</h1>

				<p
					data-reveal
					style="--reveal-delay:160ms"
					class="mt-7 max-w-[46ch] text-xl leading-[1.5]"
				>
					I've been building web applications since 2006, taking on{" "}
					<span
						class="relative isolate inline-block before:absolute before:inset-x-[-0.2em] before:inset-y-[0.14em] before:-z-10 before:-rotate-[1.2deg] before:rounded-[3px] before:bg-accent-two/20"
						>various roles along the way</span
					> — from Software Developer and Lead Developer to CTO and Head of
					Research and Development, and today Web Tech Lead at Situm.
				</p>

				<p
					data-reveal
					style="--reveal-delay:200ms"
					class="mt-5 max-w-[50ch] text-lg leading-relaxed text-color-600"
				>
					Across every project the goal has been the same: build meaningful,
					reliable tools that have a real impact on people's lives.
				</p>

				<dl
					data-reveal
					style="--reveal-delay:240ms"
					class="mt-9 grid max-w-[30rem] grid-cols-2 gap-x-8 border-t border-color-250 pt-5 sm:grid-cols-3"
				>
					<div>
						<dt
							class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-color-550"
						>
							Based in
						</dt>
						<dd class="mt-1 text-base text-accent-base">Galicia, Spain</dd>
					</div>
					<div>
						<dt
							class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-color-550"
						>
							Since
						</dt>
						<dd class="mt-1 text-base tabular-nums text-accent-base">2006</dd>
					</div>
					<div class="mt-4 sm:mt-0">
						<dt
							class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-color-550"
						>
							Now
						</dt>
						<dd class="mt-1 text-base text-accent-base">Web Tech Lead</dd>
					</div>
				</dl>
			</div>

			{/* First on a phone: stacked, the portrait would otherwise land after all
				the copy. Same order as the homepage hero on mobile.

				The reveal is "rise", not "scale": this portrait is the page's LCP
				element, and the scale variant still starts at opacity 0, which
				disqualifies it as an LCP candidate until JS reveals it. See global.css. */}
			<div class="order-first md:order-none md:col-span-5">
				<Avatar
					src={profilePic}
					alt="Fran Dieguez"
					eager
					shape="frame"
					widths={[320, 480, 760, 960]}
					sizes="(min-width: 768px) 38vw, 100vw"
					data-reveal="rise"
					style="--reveal-delay:120ms"
				/>
			</div>
		</div>
	</section>

	<!-- Tech -->
	<section aria-labelledby="tech-heading" class="pb-16 md:pb-24">
		<div class="flex flex-col gap-4 md:flex-row md:items-end md:gap-8">
			<div data-reveal>
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-color-550">
					01 — The stack
				</p>
				<h2 class="display-heading mt-2" id="tech-heading">
					<span
						class="block font-heading text-[2.125rem] font-bold leading-[0.95] tracking-[-0.02em] text-accent-base md:text-[3.5rem]"
					>
						The stack
					</span>
				</h2>
			</div>
			<HandRule class="hidden flex-1 md:mb-4 md:block" />
		</div>

		<div class="mt-8 grid grid-cols-1 gap-8 md:mt-12 md:grid-cols-2 md:gap-12">
			<div data-reveal>
				<p
					class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-accent-two"
				>
					Server side
				</p>
				<p class="mt-3 max-w-[48ch] text-base leading-relaxed text-color-600">
					The journey began with Ruby and PHP before expanding into Go. Most
					recently it's been Node.js and Java/Spring Boot, building
					high-performance microservices and distributed systems.
				</p>
			</div>
			<div data-reveal style="--reveal-delay:90ms">
				<p
					class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-accent-two"
				>
					Client side
				</p>
				<p class="mt-3 max-w-[48ch] text-base leading-relaxed text-color-600">
					From the early days of the web — VanillaJS and jQuery, through AngularJS
					and Angular 2 — and finally to React, which has become my main focus for
					building modern, high-performance interfaces.
				</p>
			</div>
		</div>

		<p
			data-reveal
			style="--reveal-delay:150ms"
			class="mt-10 max-w-[58ch] text-lg leading-relaxed text-color-600"
		>
			My interests revolve around web performance optimization, sustainable
			engineering, and promoting open-source technologies that foster
			collaboration and long-term maintainability.
		</p>
	</section>

	<!-- Work -->
	<section aria-labelledby="work-heading" class="pb-16 md:pb-24">
		<div class="flex flex-col gap-4 md:flex-row md:items-end md:gap-8">
			<div data-reveal>
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-color-550">
					02 — Work
				</p>
				<h2 class="display-heading mt-2" id="work-heading">
					<span
						class="block font-heading text-[2.125rem] font-bold leading-[0.95] tracking-[-0.02em] text-accent-base md:text-[3.5rem]"
					>
						Work
					</span>
				</h2>
			</div>
			<HandRule class="hidden flex-1 md:mb-4 md:block" />
		</div>

		<!-- The rail sits outside the list so the <ol> only ever contains <li>. -->
		<div class="relative mt-12">
			<!-- Centred on the same 7px axis as the node on each entry, which is what
				keeps the line running through the middle of the dots. The node is
				14px and this is 1px, so sharing a `left` value aligned their left
				edges and pushed every dot 6.5px right of the line.

				The half pixel is deliberate and cannot be a `-translate-x-1/2`:
				global.css owns `transform` on [data-rail] to draw the rail downwards
				with scaleY, so a translate utility here is silently overridden — and
				would break the draw if it won. The node centres itself with a
				translate instead, because nothing else touches its transform. -->
			<span
				aria-hidden="true"
				data-rail
				class="absolute bottom-6 left-[6.5px] top-3 w-px bg-gradient-to-b from-accent-two/50 via-color-200 to-transparent"
			></span>
			<ol role="list">
				{
					career.map((entry, i) => (
						<li>
							<CareerDetail entry={entry} index={i} />
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Off keyboard -->
	<section aria-labelledby="offkeyboard-heading" class="pb-20 md:pb-28">
		<div class="flex flex-col gap-4 md:flex-row md:items-end md:gap-8">
			<div data-reveal>
				<p class="font-mono text-xs uppercase tracking-[0.22em] text-color-550">
					03 — Away from the keyboard
				</p>
				<h2 class="display-heading mt-2" id="offkeyboard-heading">
					<span
						class="block font-heading text-[2.125rem] font-bold leading-[0.95] tracking-[-0.02em] text-accent-base md:text-[3.5rem]"
					>
						Off keyboard
					</span>
				</h2>
			</div>
			<HandRule class="hidden flex-1 md:mb-4 md:block" />
		</div>

		<ul role="list" class="mt-10 divide-y divide-color-250 md:mt-12">
			<li data-reveal class="grid gap-x-8 py-5 md:grid-cols-[10rem_1fr]">
				<p
					class="font-mono text-xs uppercase tracking-[0.16em] text-accent-two md:pt-1"
				>
					Open source
				</p>
				<p class="mt-2 max-w-[54ch] text-base leading-relaxed text-color-600 md:mt-0">
					Contributing to <strong class="font-medium text-accent-base">GNOME</strong>
					as a long-time member of the GNOME Foundation, and coordinating the
					Galician translation team for Ubuntu.
				</p>
			</li>
			<li
				data-reveal
				style="--reveal-delay:45ms"
				class="grid gap-x-8 py-5 md:grid-cols-[10rem_1fr]"
			>
				<p
					class="font-mono text-xs uppercase tracking-[0.16em] text-accent-two md:pt-1"
				>
					Outdoors
				</p>
				<p class="mt-2 max-w-[54ch] text-base leading-relaxed text-color-600 md:mt-0">
					Training at the gym, CrossFit, hiking through the forests of Galicia, and
					snowboarding whenever there's snow.
				</p>
			</li>
			<li
				data-reveal
				style="--reveal-delay:90ms"
				class="grid gap-x-8 py-5 md:grid-cols-[10rem_1fr]"
			>
				<p
					class="font-mono text-xs uppercase tracking-[0.16em] text-accent-two md:pt-1"
				>
					Home automation
				</p>
				<p class="mt-2 max-w-[54ch] text-base leading-relaxed text-color-600 md:mt-0">
					Most of my house runs on Home Assistant and Zigbee2MQTT, with custom
					automations that make daily life smoother — and geekier.
				</p>
			</li>
			<li
				data-reveal
				style="--reveal-delay:135ms"
				class="grid gap-x-8 py-5 md:grid-cols-[10rem_1fr]"
			>
				<p
					class="font-mono text-xs uppercase tracking-[0.16em] text-accent-two md:pt-1"
				>
					Reading
				</p>
				<p class="mt-2 max-w-[54ch] text-base leading-relaxed text-color-600 md:mt-0">
					Mostly about technology, design and personal growth, and exploring ideas
					for making tech more accessible and sustainable.
				</p>
			</li>
		</ul>

		<p
			data-reveal
			class="mt-10 max-w-[52ch] text-lg leading-relaxed text-color-600"
		>
			Open to collaborating on innovative or meaningful projects — <a
				class="citrus-link font-medium text-accent-two"
				href="/contact/">get in touch</a
			>.
		</p>
	</section>
	{/* One dialog for every career screenshot on the page. */}
	<Lightbox />
</PageLayout>
