---
/**
 * A series landing page: what the series is, and every instalment in order.
 *
 * Migrated off the starter's version, which was the last page on the site still
 * carrying it (DESIGN.md §9.1). What went:
 *
 * - Eight absolutely positioned `from-blue-300 via-pink-300` gradient blobs in a
 *   `blur-2xl` layer, with a TODO above them admitting the approach was not
 *   optimal. §6.1 replaced that language with static organic shapes and the
 *   paper grain, and the palette here was literal Tailwind colours rather than
 *   theme tokens, so it did not follow the dark theme either.
 * - `drop-shadow-xl` on the back-to-top button and a `shadow-[0px_10px_25px_…]`
 *   on the mobile drawer trigger. §5.2: elevation is `bg-special-*`, not shadow.
 * - A `.title` h1, where every other page uses PageHeading's display scale.
 * - A commented-out second mobile button, a `mobile-button` custom element whose
 *   icon was commented out so it rendered an empty box, and three `console.log`
 *   calls shipped to production.
 */
import { type CollectionEntry, render } from "astro:content";
import TOC from "@/components/blog/TOC.astro";
import SeriesPanel from "@/components/SeriesPanel.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import { getAllPosts } from "@/data/post";
import { Icon } from "astro-icon/components";
import BaseLayout from "./Base.astro";

interface Props {
	series: CollectionEntry<"series">;
}

const { series } = Astro.props;
const { title, description } = series.data;

const { headings } = await render(series);

// The eyebrow states how much of the series actually exists. A series file can
// be committed before its first instalment publishes, and saying "3 parts" when
// none are readable yet would be a promise the page cannot keep.
const posts = await getAllPosts();
const published = posts.filter((p) => p.data.seriesId === series.id).length;
const eyebrow = published === 0
	? "Series — in progress"
	: `Series — ${published} ${published === 1 ? "part" : "parts"}`;
---

<BaseLayout meta={{ description, title }}>
	{series.id && <SeriesPanel slot="sidebar" seriesId={series.id} />}

	<div class="flex items-center gap-2 md:sticky md:top-4 md:z-20">
		<button
			id="toggle-panel"
			class="z-30 hidden size-8 shrink-0 items-center justify-center rounded-lg bg-accent-base/10 text-accent-base transition-colors duration-200 hover:text-accent-two md:flex"
			aria-label="Toggle series panel"
			aria-controls="series-panel"
			aria-expanded="true"
		>
			<Icon aria-hidden="true" class="size-5" focusable="false" name="solar:notes-bold" />
		</button>
		<button
			id="toggle-toc"
			class="z-30 hidden size-8 shrink-0 items-center justify-center rounded-lg bg-accent-base/10 text-accent-base transition-colors duration-200 hover:text-accent-two md:flex"
			aria-label="Toggle table of contents"
			aria-controls="toc-panel"
			aria-expanded="true"
		>
			<Icon aria-hidden="true" class="size-5" focusable="false" name="solar:clipboard-list-bold" />
		</button>
	</div>

	<PageHeading eyebrow={eyebrow} title={title} standfirst={description} class="mt-6" />

	<div class="flex gap-x-8 pb-20 md:items-start md:pb-28">
		<article class="grid flex-grow grid-cols-1 break-words" data-pagefind-body>
			<div
				data-reveal
				class="prose prose-citrus max-w-none flex-grow prose-headings:font-semibold prose-headings:text-accent-base prose-headings:before:text-accent-two sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
				<slot />
			</div>
		</article>
		{
			!!headings.length && (
				<aside
					id="toc-panel"
					class="sticky z-10 hidden rounded-lg md:top-20 md:block md:w-[16rem] md:min-w-[16rem]"
				>
					<TOC headings={headings} />
				</aside>
			)
		}
	</div>

	<div class="left-0 right-12 z-50 ml-auto w-fit md:absolute">
		<button
			id="to-top-button"
			class="fixed bottom-14 flex size-12 translate-y-28 items-center justify-center rounded-full border border-color-250 bg-special-lighter text-accent-base transition-all duration-300 hover:text-accent-two data-[show=true]:translate-y-0 data-[show=true]:opacity-100"
			aria-label="Back to top"
			data-show="false"
		>
			<svg
				class="size-6"
				fill="none"
				focusable="false"
				stroke="currentColor"
				stroke-width="2"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>

	<button
		id="toggle-panel-mobile"
		class="fixed bottom-4 right-4 z-50 flex size-12 items-center justify-center rounded-lg border border-color-250 bg-special-lighter text-accent-base transition-colors duration-200 hover:text-accent-two sm:hidden"
		aria-label="Toggle series panel"
		aria-controls="series-panel"
	>
		<Icon aria-hidden="true" class="size-6" focusable="false" name="solar:notes-bold" />
	</button>
</BaseLayout>

<script>
	// Both triggers drive the same drawer, so they share one handler and one
	// source of truth for whether it is open. `aria-expanded` is kept in sync on
	// whichever trigger is visible — it was absent before, so a screen reader was
	// told nothing about the drawer's state.
	const ANIMATION_DURATION = 300;

	function bindSeriesPanel() {
		const panel = document.getElementById("series-panel");
		if (!panel) return;

		const triggers = [
			document.getElementById("toggle-panel"),
			document.getElementById("toggle-panel-mobile"),
		].filter((el): el is HTMLElement => el !== null);
		const closeBtn = document.getElementById("close-panel");

		const isVisible = () => {
			const isLarge = window.matchMedia("(min-width: 1024px)").matches;
			return isLarge ? panel.classList.contains("lg:block") : !panel.classList.contains("hidden");
		};

		const sync = () => {
			for (const trigger of triggers) {
				trigger.setAttribute("aria-expanded", String(isVisible()));
			}
		};

		const hide = () => {
			panel.classList.add("opacity-0", "-translate-x-full");
			window.setTimeout(() => {
				panel.classList.remove("block", "lg:block");
				panel.classList.add("hidden");
				sync();
			}, ANIMATION_DURATION);
		};

		const show = () => {
			panel.classList.remove("hidden");
			panel.classList.add("block", "lg:block");
			window.setTimeout(() => {
				panel.classList.remove("opacity-0", "-translate-x-full");
				sync();
			}, 10);
		};

		for (const trigger of triggers) {
			trigger.addEventListener("click", () => (isVisible() ? hide() : show()));
		}
		closeBtn?.addEventListener("click", hide);
		sync();
	}

	function bindToc() {
		const panel = document.getElementById("toc-panel");
		const trigger = document.getElementById("toggle-toc");
		if (!panel || !trigger) return;

		trigger.addEventListener("click", () => {
			const isOpen = panel.classList.contains("md:block");
			panel.classList.toggle("md:block", !isOpen);
			panel.classList.toggle("hidden", isOpen);
			trigger.setAttribute("aria-expanded", String(!isOpen));
		});
	}

	function bindBackToTop() {
		const button = document.getElementById("to-top-button");
		const header = document.querySelector("header");
		if (!button || !header) return;

		button.addEventListener("click", () => {
			document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
		});

		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				button.dataset.show = String(!entry.isIntersecting);
			}
		});
		observer.observe(header);
	}

	// astro:page-load, never DOMContentLoaded: with <ClientRouter /> active the
	// latter does not fire again after a navigation. DESIGN.md §6.2.
	document.addEventListener("astro:page-load", () => {
		bindSeriesPanel();
		bindToc();
		bindBackToTop();
	});
</script>
