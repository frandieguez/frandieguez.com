---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import StructuredData from "@/components/StructuredData.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { personSchema, websiteSchema } from "@/data/schema";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/**
	 * Wraps the header and the `hero` slot in a full-bleed band that is dark in
	 * both themes. Pages that don't set it render exactly as before.
	 */
	heroBand?: boolean;
	/**
	 * Page-specific JSON-LD nodes. Person and WebSite are added here for every
	 * page, so callers only pass what is particular to them (BlogPosting,
	 * BreadcrumbList, ProfilePage, CollectionPage).
	 */
	schema?: Record<string, unknown>[];
}

const {
	meta: {
		articleDate,
		description = siteConfig.description,
		lang = siteConfig.lang,
		noindex,
		ogImage,
		title,
	},
	heroBand = false,
	schema = [],
} = Astro.props;

const graph = [websiteSchema(), personSchema(), ...schema];
---

<!-- `lang` is per-page, not sitewide. Roughly half this archive is written in
	Spanish or Galician, and every one of those pages used to declare itself as
	en-GB — which sends screen readers to the wrong pronunciation engine and
	suppresses the browser's own translation prompt. -->
<html
	class="overflow-x-hidden grid scroll-pt-20 scroll-smooth font-sans text-textColor text-xl md:text-base antialiased"
	lang={lang}
>
	<head>
		<BaseHead
			articleDate={articleDate}
			description={description}
			lang={lang}
			noindex={noindex}
			ogImage={ogImage}
			title={title}
		/>
		<StructuredData graph={graph} />
	</head>
	<!-- No `min-w-*` here. It used to carry `min-w-4xl`, which computes to
		min-width: 1080px, so every phone was handed a 1080px page folded into a
		~400px viewport. The `overflow-x-hidden` on <html> above hid the scrollbar
		that would have made it obvious, which is why it survived this long. -->
	<body class="relative m-auto min-h-screen w-full max-w-6xl grow bg-bgColor">
		<ThemeProvider />
		<SkipLink />

		<!-- Paper grain. One repeating 180px tile, in place of the eight blurred
			gradient layers that used to live here (and whose own TODO flagged them
			as a performance problem). The tint comes from the page background
			through mix-blend-mode, so there's no colour value to keep in sync. -->
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-0 z-0 bg-[image:var(--paper-grain)] bg-[length:180px_180px] bg-repeat opacity-[0.035] mix-blend-multiply dark:opacity-[0.07] dark:mix-blend-screen"
		>
		</div>

		<!-- `isolate` is load-bearing: without its own stacking context this wrapper
			gets pulled into the grain's blending group and images stop painting. -->
		<div class="relative isolate z-10 flex min-h-screen w-full">
			<!-- Sidebar for Docs Series -->
			<slot name="sidebar" />
			<!-- Main container for the page content -->
			<!-- Same again: `min-w-3xl` was 960px. Both floors have to go, or the
				remaining one still overflows. -->
			<div id="container" class="relative m-auto max-w-6xl grow">
				{/* No top padding under a hero band: the band is min-h-screen, so 16px
					above it would push its bottom edge — and the tech stack line sitting
					just inside it — below the fold. */}
				<div
					class:list={[
						"m-auto grid min-h-screen px-4 md:grid-rows-[auto_auto_1fr] md:px-8",
						!heroBand && "md:pt-4",
					]}
				>
					{
						heroBand ? (
							<div class="surface-dark relative flex min-h-screen flex-col">
								{/* Full-bleed backdrop. The container is padded and capped at
									max-w-6xl, so the band has to break out with the
									left-1/2 / -ml-[50vw] / w-screen trick. The -top-8 covers
									the grid's md:pt-4 above the header. */}
								<span
									aria-hidden="true"
									class="absolute -top-8 bottom-0 left-1/2 -ml-[50vw] w-screen bg-bgColor"
								/>
								{/* pt-16 on mobile clears the header, which is fixed below md. */}
								{/* Compact logo: a page with a hero band states the name at
									display size, so the header showing the full FRAN DIEGUEZ
									wordmark right above it says it twice. The glasses mark alone
									carries the identity there. */}
								<div class="relative flex flex-1 flex-col pt-16 md:pt-0">
									<Header compact />
									<slot name="hero" />
								</div>
							</div>
						) : (
							<Header />
						)
					}
					<main
						id="main"
						class:list={[
							"relative flex-grow",
							heroBand ? "mt-12 md:mt-16" : "mt-24 md:mt-[3.5rem]",
						]}
						transition:animate="initial"
					>
						<slot />
					</main>
					<Footer />
				</div>
			</div>
		</div>
		<script>
			import "@/scripts/reveal";
			import "@/scripts/title-transition";
		</script>
	</body>

</html>
